{
  "display": {
    "family": "Bricolage Grotesque",
    "weight": 800,
    "width": "condensed",
    "use": "títulos, cifras, bloques"
  },
  "texto": {
    "family": "Instrument Sans",
    "weight": [
      400,
      600
    ],
    "use": "subtítulos, citas, etiquetas"
  },
  "mono": {
    "family": "IBM Plex Mono",
    "weight": [
      500,
      600
    ],
    "use": "fuentes, fechas, sellos"
  },
  "reglas": {
    "maxPalabrasPorPlaca": 7,
    "fuenteFormato": "FUENTE · {medio} — {dd/mm/aaaa}",
    "fuentePosicion": "inferior-izquierda"
  },
  "cinetica": {
    "entrada": {
      "family": "Instrument Sans",
      "sizeRel": 0.45
    },
    "clave": {
      "family": "Bricolage Grotesque",
      "weight": 800,
      "width": "condensed",
      "tracking": "-0.03em"
    },
    "maxLineas": 2,
    "palabraPendiente": {
      "opacity": 0.4
    },
    "palabraDicha": {
      "opacity": 1
    },
    "easing": "sello",
    "offsetYpx": [
      8,
      12
    ],
    "fondoGigante": {
      "scaleRel": [
        3,
        4
      ],
      "opacity": [
        0.1,
        0.15
      ],
      "parallax": "lateral lento"
    },
    "climax": "1 por video, texto a sangre"
  }
}